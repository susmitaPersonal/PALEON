# The M0 harness does not read .env. For Stage D, export OPENROUTER_API_KEY and HF_TOKEN in the shell.
# Copy to .env for local overrides. Demo mode needs no file and no key.
# Never commit .env. Real keys belong only in your local environment.

PORT=8787
LOG_LEVEL=info

# mock: simulated fixtures, no network. This is the default.
MODEL_PROVIDER=mock

# Real inference sends user images to a third party. It stays off unless both of these are set:
#   MODEL_PROVIDER=openai-compatible
#   ALLOW_EXTERNAL_INFERENCE=true
ALLOW_EXTERNAL_INFERENCE=false
MODEL_BASE_URL=
MODEL_ID=
MODEL_API_KEY=

# Optional list prices, used only to estimate cost from reported tokens.
MODEL_INPUT_USD_PER_MTOK=
MODEL_OUTPUT_USD_PER_MTOK=

MODEL_TIMEOUT_MS=45000
MODEL_MAX_RETRIES=1
ANALYSIS_DEADLINE_MS=55000
EXPERIMENT_ID=

MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=120000000
MAX_MODEL_IMAGE_EDGE=2048
RATE_LIMIT_PER_MINUTE=20
# Set true only behind a proxy that overwrites x-forwarded-for. Otherwise clients can forge it.
TRUST_PROXY=false
MAX_CONCURRENT_ANALYSES=4
