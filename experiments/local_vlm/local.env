# Settings for local inference on an 8 GB Apple M1. Load with: set -a; source experiments/local_vlm/local.env; set +a
MODEL_PROVIDER=ollama
RAW_OUTPUT_DIR=experiments/local_vlm/records/raw
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=900
OLLAMA_KEEP_ALIVE=10m
# Local inference is slow, and repeating a timed-out attempt only makes the wait longer.
MODEL_TIMEOUT_MS=1800000
ANALYSIS_DEADLINE_MS=1810000
MODEL_MAX_RETRIES=0
MAX_CONCURRENT_ANALYSES=1
MAX_MODEL_IMAGE_EDGE=768
